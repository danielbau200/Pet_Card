        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=6;shadow=1;align=center;verticalAlign=top;spacingTop=12;fontSize=13;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" value="&lt;b&gt;CUADRO DE RELACIONES UML&lt;/b&gt;" vertex="1">
