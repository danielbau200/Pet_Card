# ─── SERVIDOR ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── POSTGRESQL ───────────────────────────────────────────────────────────────
# Opción A: Conexión local mediante variables individuales
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pet_card_is_db
DB_USER=postgres
DB_PASSWORD=

# Opción B: URL completa (si se define DATABASE_URL tiene prioridad con SSL)
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# ─── AUTENTICACIÓN JWT ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── GOOGLE OAUTH 2.0 (Opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── CLOUDINARY (Almacenamiento de fotos y recetas PDF) ───────────────────────
# Si no se configura, el sistema guarda automáticamente en public/uploads/
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── GEMINI IA (Triaje veterinario de síntomas) ───────────────────────────────
# Si no se configura, /api/triage usa un modo simulado de respaldo
GEMINI_API_KEY=your_gemini_api_key

# ─── CORREO SMTP (Avisos del QR de emergencia) ────────────────────────────────
# Si no se configura, los correos se muestran simulados en consola
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_password_aplicacion

# ─── FRONTEND & CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com
PUBLIC_URL=http://localhost:3000

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
